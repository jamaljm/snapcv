# Copy to .env and fill in. Never commit the real .env.

# OpenAI API key used for résumé extraction. Required — the server won't boot without it.
OPENAI_KEY=sk-...

# Port to listen on (default 5000). Most hosts inject this automatically.
PORT=5000

# Comma-separated allowed CORS origins (your frontend). Defaults to localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000,https://www.snapcv.me
