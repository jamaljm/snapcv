# Copy to .env.local and fill in. Never commit the real .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used by server-side API routes. Anon key is fine for local dev; use a
# service-role key only in a trusted server environment.
SUPABASE_ANON_KEY=your-anon-or-service-key

# --- App URLs ---
# Base URL the app uses to call its own /api routes (server components).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# The SnapCV backend that turns a résumé PDF into structured JSON (see /backend).
NEXT_PUBLIC_BACKEND=http://localhost:5000

# --- GitHub Wrapped (optional) ---
# Server-side GitHub token for the "GitHub Wrapped" feature (GraphQL API).
GITHUB_TOKEN=your-github-token
